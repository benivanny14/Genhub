// =============================================================================
// FREEBUFF - Video Monetization & Streaming Platform
// Complete Prisma Schema for PostgreSQL
// =============================================================================

generator client {
  provider = "prisma-client-js"
  // The client is generated once and then shipped somewhere else. Without this
  // line the generator downloads the query engine for the machine that ran
  // `prisma generate` and nothing else, so a client generated on a developer's
  // Windows laptop is useless to the Linux build image — and the reverse. The
  // failure surfaces as "Unable to require(...) : Prisma engines do not seem to
  // be compatible with your system", or as a PrismaClientInitializationError
  // with no errorCode, at whatever point a page first touches the database.
  //
  // `native` keeps local development and tests on the platform's own engine;
  // `rhel-openssl-3.0.x` is the engine Vercel's Node 20 runtime needs. Both are
  // fetched, so the build does not depend on which machine ran the generate.
  //
  // See src/tests/build-generates-client.test.ts, which pins this list.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum UserRole {
  VIEWER
  CREATOR
  ADMIN
}

enum KycStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum TransactionType {
  PPV_PURCHASE
  SUBSCRIPTION
  WALLET_TOPUP
  TIP
  PLATFORM_FEE
  REFERRAL_BONUS
  /// What a creator pays the platform for a month of the blue tick. A sale in
  /// the other direction: the platform is the seller, so the money leaves the
  /// creator's wallet/earnings and no creator balance is credited.
  BLUE_TICK
}

/// Where a paid blue-tick request stands.
///
/// PAID means the creator has been charged and the platform owes them a
/// decision — the tick is NOT live yet (an admin approves it). APPROVED is a
/// live month; EXPIRED is one that ran out and has to be bought again.
/// REJECTED was refunded.
enum BlueTickStatus {
  PAID
  APPROVED
  REJECTED
  EXPIRED
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
  // A USSD prompt that we can neither confirm nor deny: the gateway accepted
  // the charge and never settled it, so the customer MAY already have paid.
  // Deliberately NOT "FAILED" — telling someone to "try again" when their money
  // left their handset is how the same purchase gets charged twice. Someone has
  // to check with the network before this becomes SUCCESS or FAILED.
  UNDER_INVESTIGATION
}

// Genhub settles every checkout through SonicPesa (USSD push to the phone).
// HARAKAPAY and CLICKPESA are kept as historical values so the transactions and
// subscriptions they processed stay readable; neither can ever settle a new
// payment (see src/lib/payments/gateway.ts). New values are APPENDED on purpose,
// so each migration is a plain ADD VALUE and old rows are untouched.
enum PaymentGateway {
  HARAKAPAY
  CLICKPESA
  SONICPESA
}

enum PayoutMethod {
  MPESA
  TIGO_PESA
  AIRTEL_MONEY
  BANK_TRANSFER
}

enum PayoutStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

enum ReportReason {
  DMCA
  INAPPROPRIATE
  SPAM
  VIOLENCE
  OTHER
}

enum StrikeAction {
  WARNING
  HIDDEN
  FROZEN_EARNINGS
  BANNED
}

// =============================================================================
// USER MODEL
// =============================================================================

model User {
  id           String   @id @default(cuid())
  phone        String?  @unique
  email        String?  @unique
  /// Public, unique handle: the one name on an account nobody else may take.
  ///
  /// `displayName` is free text and two accounts can share it, so it cannot stop
  /// one person from passing as another. `username` is the stable, quoted,
  /// lowercased handle (see lib/usernames.ts) and carries a UNIQUE index so the
  /// database — not just the application — refuses a duplicate. New sign-ups are
  /// required to choose one; existing rows are backfilled by the migration, so
  /// in practice every account has a value. It stays nullable so a legacy row is
  /// never the thing that blocks a deploy, and the app treats a missing handle
  /// as "no handle yet" rather than crashing.
  username     String?  @unique
  passwordHash String
  displayName  String?
  avatarUrl    String?
  role         UserRole @default(VIEWER)
  kycStatus    KycStatus @default(NONE)
  isBanned     Boolean  @default(false)
  banReason    String?
  strikes      Int      @default(0)
  walletBalance Int     @default(0) // In TZS, stored as integer (kopecks not needed for TZS)
  isVerified    Boolean @default(false) // Public verification badge
  /// When a PAID blue tick expires. NULL while the badge came from an admin
  /// (or predates this column), which never expires on its own. A tick bought
  /// for a month carries the date it runs out, so the badge can be taken down
  /// without an admin remembering to: see services/blue-tick.service.ts.
  verifiedUntil DateTime?
  referralCode  String?  @unique // Shareable code for the affiliate program
  referredById  String?  // Who invited this user
  referralEarnings Int   @default(0) // Lifetime TZS earned from referrals
  // A creator can close their inbox at any time and reopen it later. ON by
  // default so the feature exists the moment someone wants it off, and so an
  // existing account does not silently gain a "no messages" state it never
  // chose. Enforced in POST /api/messages (the sender is refused, politely).
  messagesEnabled Boolean @default(true)
  // Admin freeze on withdrawals. `null` = not frozen. The date, not a boolean,
  // so a freeze can be time-boxed ("until Friday") and lifts itself — an admin
  // who forgets to unfreeze does not leave a creator locked out forever.
  payoutFrozenUntil  DateTime?
  payoutFrozenReason String?
  // Admin OVERRIDE of the withdrawal floor. OFF by default: a creator may only
  // withdraw once their balance reaches config.business.minPayoutAmount. When an
  // admin turns this ON for one account, that creator may withdraw any amount,
  // including below the floor — the "let this person take out a small amount"
  // lever. On the account rather than on CreatorBalance because it is a
  // permission about the person, not a number about their money.
  payoutMinimumWaived Boolean @default(false)
  // "This account watches everything free." An admin turns it on for one user
  // and off again; while it is on, resolveVideoEntitlement grants every paid
  // scene without a purchase, subscription or charge. A boolean rather than a
  // date because it is a switch an admin flips, not a subscription that lapses
  // — the admin who granted it is recorded in AdminAuditLog (user.free_access
  // / user.revoke_free_access), so "who gave this away, and when?" is answered
  // there rather than by another column here.
  freeAccess         Boolean  @default(false)
  // The version of the creator guidelines this account accepted, and when.
  // 0 = never accepted. Kept on the account rather than in the browser so the
  // re-acceptance gate is the same on every device the creator signs in on, and
  // so bumping CREATOR_GUIDELINES_VERSION asks every creator again.
  guidelinesAcceptedVersion Int       @default(0)
  guidelinesAcceptedAt      DateTime?
  // When this creator last received the weekly earnings digest. NULL = never.
  // The digest job runs often and sends only when seven days have passed, so
  // this column is both the cadence and the at-most-once guard (the job claims
  // it with a conditional update before it sends).
  lastEarningsDigestAt      DateTime?
  // Whether the weekly earnings digest is sent to this creator. ON by default
  // (opt-out), so an existing creator keeps getting the one email that explains
  // the 14-day hold; a creator who does not want it can turn it off.
  earningsDigestEnabled     Boolean  @default(true)
  locale       String   @default("sw") // sw = Kiswahili, en = English
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  videos              Video[]
  transactions        Transaction[]      @relation("ViewerTransactions")
  creatorTransactions Transaction[]      @relation("CreatorTransactions")
  videoAccess         VideoAccess[]
  reporterReports     VideoReport[]      @relation("ReporterReports")
  resolvedReports     VideoReport[]      @relation("ReportResolver")
  kycVerifications    KycVerification[]
  kycReviews          KycVerification[]  @relation("KYCReviewer")
  creatorBalance      CreatorBalance?
  payoutRequests      PayoutRequest[]
  processedPayouts    PayoutRequest[]    @relation("PayoutProcessor")
  sentMessages        PayMessage[]       @relation("SenderMessages")
  receivedMessages    PayMessage[]       @relation("ReceiverMessages")
  subscriptions       CreatorSubscription[] @relation("SubscriptionViewer")
  subscriberOf        CreatorSubscription[] @relation("SubscriptionCreator")
  videoLikes          VideoLike[]
  favorites           Favorite[]
  passwordResets      PasswordReset[]
  notifications       Notification[]
  comments            Comment[]
  watchProgresses     WatchProgress[]
  creatorProfile      CreatorProfile?
  referredBy          User?    @relation("Referrals", fields: [referredById], references: [id])
  referrals           User[]   @relation("Referrals")
  posts               CreatorPost[]
  playlists           Playlist[]
  couponRedemptions   CouponRedemption[]
  blueTickRequests    BlueTickRequest[]
  appeals             Appeal[]
  pushSubscriptions   PushSubscription[]

  @@index([email])
  @@index([referralCode])
  @@index([phone])
  @@index([role])
  @@index([kycStatus])
  @@index([isBanned])
}

// =============================================================================
// APPEALS
//
// When an account is suspended, the person's only route back was to email and
// hope. There was no queue, no status they could see, and no record of the
// decision — so "did anyone read my appeal?" had no answer. This is that queue:
// one row per request, readable by the person who filed it and by the admins who
// decide it.
//
// The verdict is stamped with who made it and when, and every decision writes
// an AdminAuditLog entry as well (appeal.resolved), so the appeal row can be
// edited for tidiness without erasing the fact that a decision happened.
// =============================================================================

model Appeal {
  id           String       @id @default(cuid())
  userId       String
  /// What is being appealed: BAN | KYC | CONTENT.
  kind         String       @default("BAN")
  message      String
  status       AppealStatus @default(PENDING)
  reviewedBy   String?
  reviewerNote String?
  reviewedAt   DateTime?
  createdAt    DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId])
  @@index([createdAt])
}

enum AppealStatus {
  PENDING
  APPROVED
  REJECTED
}

// =============================================================================
// PUSH SUBSCRIPTIONS
//
// One row per device a person has allowed browser notifications on. The
// `endpoint` is unique because it IS the device: re-subscribing the same phone
// must update the keys it rotates, not add a second row that sends the same
// notification twice. A dead endpoint is deleted when the push service rejects
// it (see lib/services/push.service.ts) rather than kept forever.
//
// The keys are secrets in the same sense a password hash is: they let us send a
// message only the browser that made them can read, so they never leave the
// server.
// =============================================================================

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  /// The push service URL for one browser install. @unique — see above.
  endpoint  String   @unique
  p256dh    String
  auth      String
  /// Best-effort label, so a person with several devices can tell rows apart.
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// =============================================================================
// KYC VERIFICATION MODEL
// =============================================================================

model KycVerification {
  id              String     @id @default(cuid())
  userId          String
  idDocumentUrl   String     // URL to uploaded government ID
  selfieUrl       String     // URL to selfie with handwritten note
  idDocumentType  String?    // NIDA, Passport, etc.
  status          KycStatus  @default(PENDING)
  rejectionReason String?
  reviewedBy      String?    // Admin userId who reviewed
  reviewedAt      DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  // Relations
  user     User @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewer User? @relation("KYCReviewer", fields: [reviewedBy], references: [id])

  @@index([userId])
  @@index([status])
}

// =============================================================================
// VIDEO MODEL
// =============================================================================

model Video {
  id              String   @id @default(cuid())
  creatorId       String
  title           String
  description     String?
  slug            String?  @unique
  bunnyVideoId    String   @unique // Bunny.net Stream Video ID
  previewUrl      String?  // Optional custom HLS URL (demo/migrated content overrides Bunny)
  /// Bunny id of a SEPARATE short clip shown to non-buyers. Without it a paid
  /// scene has no preview at all (see resolveTeaserUrl) — signing the main
  /// video for non-buyers hands them the whole scene, because Bunny tokens
  /// authorise a path and cannot limit duration.
  teaserBunnyVideoId String? @unique
  /// Same idea for side-loaded content: a stored, publicly reachable trailer
  /// URL (demo / migrated rows), symmetric with previewUrl. Ignored when
  /// teaserBunnyVideoId is set.
  teaserClipUrl   String?
  thumbnailUrl    String?
  /// WebVTT captions for this scene, as a URL the browser can fetch.
  ///
  /// Stored, because it cannot be derived: a subtitle file is not inside the
  /// video, and Bunny's transcoder does not produce one. Without somewhere to
  /// put it there was no way to attach captions at all — which for a deaf
  /// viewer is not a missing feature but a missing door, and for everyone else
  /// is the difference between watching on a noisy bus and not watching.
  captionsUrl     String?
  price           Int      @default(1000) // Price in TZS
  teaserDuration  Int      @default(15) // Seconds of free preview (UI: badge + hover length)
  duration        Int?     // Total duration in seconds
  viewsCount      Int      @default(0)
  likesCount      Int      @default(0)
  dislikesCount   Int      @default(0)
  purchaseCount   Int      @default(0)
  isPublished     Boolean  @default(false)
  /// A creator's unfinished post: not published, and not scheduled either.
  /// Kept separate from `scheduledAt` so "hold this until I finish it" and
  /// "publish this at 20:00" cannot be confused for each other.
  isDraft         Boolean  @default(false)
  /// When a scheduled post should go live. NULL for an immediately-published
  /// post. The row stays `isPublished: false` until a sweep sees the time pass,
  /// so the feed's existing `isPublished: true` filter hides it without change.
  scheduledAt     DateTime?
  isFlagged       Boolean  @default(false)
  isDeleted       Boolean  @default(false)
  isPremium       Boolean  @default(false) // Shown with lock + watermark
  isFeatured      Boolean  @default(false) // Highlighted in feed
  category        String?
  tags            String[]
  // 18 U.S.C. § 2257: set when the uploader attested that every performer is
  // an adult and that proof-of-age records are held on file.
  complianceAttestedAt DateTime?
  // ---------------------------------------------------------------------------
  // Bunny processing lifecycle.
  //
  // Null means "not tracked" — side-loaded/demo rows that Bunny does not
  // transcode, which must keep working exactly as they did before. Every other
  // value comes from Bunny itself; see lib/services/video-encoding.service.ts
  // for the code mapping and why "ready" never relies on one number alone.
  //
  // The states matter because Bunny accepts an upload long before the video can
  // actually play. Publishing on upload therefore puts a dead player in front of
  // paying viewers, which is what encodingStatus exists to prevent.
  encodingStatus      Int?
  /// Bunny's encodeProgress 0-100. Second, independent "is it done" signal.
  encodeProgress      Int      @default(0)
  /// Set only when Bunny reports a real failure, so creators see the reason.
  encodingError       String?
  encodingCheckedAt   DateTime?
  /// The creator's own file size, recorded when the row is created. Compared
  /// against bunnyStorageBytes it answers the only question worth asking about a
  /// stuck upload: did the host receive the whole file or not.
  uploadSizeBytes     Int?
  /// Bunny's own `storageSize` — what the HOST reports holding.
  ///
  /// NULL means Bunny has not answered with a size; 0 is an answer. Measured
  /// against the live API: 0 is what a slot mid-transfer reports AND what a slot
  /// whose transfer never completed reports, and the number only jumps to the
  /// full encoded footprint once the transcode finishes (37 MB for a 2.8 MB
  /// source, because it counts every rendition). It is therefore read next to
  /// encodingStatus, never alone.
  bunnyStorageBytes   Int?
  /// When the "it is ready" notification was sent. Guards against re-notifying
  /// on every poll, which would spam a creator every few minutes forever.
  encodingNotifiedAt  DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  creator         User          @relation(fields: [creatorId], references: [id])
  transactions    Transaction[]
  videoAccess     VideoAccess[]
  reports         VideoReport[]
  earnings        VideoEarning?
  likes           VideoLike[]
  favorites       Favorite[]
  comments        Comment[]
  watchProgresses WatchProgress[]
  playlistItems   PlaylistItem[]
  galleryImages   GalleryImage[]

  @@index([creatorId])
  @@index([isPublished])
  @@index([createdAt])
  @@index([price])
  // Drives the poller: find everything still encoding without scanning the table.
  @@index([encodingStatus])
  // Drives the scheduled-publish sweep: find posts whose time has come.
  @@index([scheduledAt])
}

// =============================================================================
// VIDEO EARNING (aggregated per video)
// =============================================================================

model VideoEarning {
  id              String   @id @default(cuid())
  videoId         String   @unique
  totalEarned     Int      @default(0) // 70% of purchases go here
  totalPurchases  Int      @default(0)
  updatedAt       DateTime @updatedAt

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId])
}

// =============================================================================
// TRANSACTION MODEL
// =============================================================================

model Transaction {
  id          String            @id @default(cuid())
  userId      String            // Viewer who paid
  creatorId   String?           // Creator who receives (null for wallet topup)
  videoId     String?           // For PPV_PURCHASE
  amount      Int               // Amount in TZS
  platformFee Int?              // 30% platform cut
  creatorCut  Int?              // 70% creator cut
  type        TransactionType
  status      TransactionStatus @default(PENDING)
  gateway     PaymentGateway?
  providerRef String?           // Reference from payment provider
  metadata    Json?             // Additional provider data
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  // Relations
  viewer     User              @relation("ViewerTransactions", fields: [userId], references: [id])
  creator    User?             @relation("CreatorTransactions", fields: [creatorId], references: [id])
  video      Video?            @relation(fields: [videoId], references: [id])
  events     PaymentEvent[]

  @@index([userId])
  @@index([creatorId])
  @@index([videoId])
  @@index([status])
  @@index([type])
  @@index([providerRef])
  @@index([createdAt])
}

// =============================================================================
// PAYMENT EVENTS (the journey of one charge)
//
// A charge can fail in a dozen places — the gateway rejects it outright, it
// throws before producing an answer, the customer approves and no settlement
// ever arrives, an admin resolves it by hand. `Transaction.status` records only
// the LAST of those, so a FAILED row tells an operator nothing about whether a
// USSD prompt was ever sent, whether a webhook ever arrived, or what the
// customer was actually shown. That is the difference between a five-minute
// diagnosis and an afternoon.
//
// One append-only row per thing that happened, with the moment it happened. The
// table is a log, not a state machine: nothing here is ever rewritten, so the
// order of the rows is the truth even after the status column has moved on.
// =============================================================================

model PaymentEvent {
  id            String   @id @default(cuid())
  transactionId String
  /// Dotted code: checkout.created, collect.started, collect.rejected,
  /// collect.failed, webhook.received, webhook.ignored, settled.success,
  /// settled.failed, investigation.open, checkout.expired, admin.action.
  kind          String
  /// One human sentence for the timeline.
  detail        String?
  metadata      Json?
  createdAt     DateTime @default(now())

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([kind])
  @@index([createdAt])
}

// =============================================================================
// CREATOR BALANCE MODEL
// =============================================================================

model CreatorBalance {
  id              String   @id @default(cuid())
  creatorId       String   @unique
  /// LEGACY. Creator earnings used to sit here for a 14-day holding period
  /// before they could be withdrawn. There is no holding period any more: every
  /// sale is credited straight to `availableBalance` (see creditCreatorAvailable
  /// in services/balance.service.ts). The column stays so the release job can
  /// still clear a balance left over from before the change; new money never
  /// lands here.
  pendingBalance  Int      @default(0)
  availableBalance Int     @default(0) // Money a payout can draw on, immediately
  totalEarned     Int      @default(0) // Lifetime earnings
  /// LEGACY. Cumulative amount released out of the old holding period.
  releasedTotal   Int      @default(0)
  /// When the admins were last told this creator's withdrawable balance crossed
  /// config.business.minPayoutAmount. NULL = not told, or told and then reset
  /// because a payout took the balance back below the floor. Dedupes the
  /// "this creator can withdraw now" alert so it fires once per crossing rather
  /// than once per sale.
  payoutReadyNotifiedAt DateTime?
  updatedAt       DateTime @updatedAt

  // Relations
  creator User @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([creatorId])
}

// =============================================================================
// PAYOUT REQUEST MODEL
// =============================================================================

model PayoutRequest {
  id             String       @id @default(cuid())
  creatorId      String
  amount         Int          // Amount in TZS
  paymentMethod  PayoutMethod
  accountDetails String       // Phone number or bank account
  bankName       String?      // For bank transfers
  status         PayoutStatus @default(PENDING)
  adminNote      String?
  /// The M-Pesa / bank receipt (transaction code) the admin typed when they
  /// actually sent the money. Required to move a request to PAID and shown to the
  /// creator on their dashboard — it is the only proof the payout left, and
  /// without it "PAID" is just an admin's word. Null while a request is PENDING
  /// or APPROVED.
  paymentReference String?
  /// The gateway's own payout id, from POST /payouts/create. This is the key the
  /// payout webhook and the status poll match on, so a row that was actually sent
  /// through SonicPesa is identifiable from a row an admin sent by hand
  /// (which leaves this null). Also what makes re-sending the same request
  /// impossible: a second create would mint a second id and pay twice.
  providerWithdrawalId String?
  /// The gateway's fee and the amount that reached the creator, copied from its
  /// own response. The recipient is paid `providerNetAmount`, which is less than
  /// `amount` — a real difference that has to be a number, not an assumption.
  providerFee        Int?
  providerNetAmount  Int?
  /// The gateway's last word on this payout (pending/completed/failed), kept so
  /// the admin can see what the network said without leaving the queue.
  providerStatus     String?
  processedBy    String?
  processedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Relations
  creator   User  @relation(fields: [creatorId], references: [id])
  processor User? @relation("PayoutProcessor", fields: [processedBy], references: [id])

  @@index([creatorId])
  @@index([status])
  @@index([createdAt])
  @@index([providerWithdrawalId])
}

// =============================================================================
// VIDEO ACCESS MODEL (tracks PPV purchases)
// =============================================================================

model VideoAccess {
  id        String   @id @default(cuid())
  viewerId  String
  videoId   String
  expiresAt DateTime? // Null = lifetime access
  createdAt DateTime @default(now())

  // Relations
  viewer User  @relation(fields: [viewerId], references: [id], onDelete: Cascade)
  video  Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([viewerId, videoId])
  @@index([viewerId])
  @@index([videoId])
}

// =============================================================================
// VIDEO REPORT MODEL
// =============================================================================

model VideoReport {
  id          String       @id @default(cuid())
  reporterId  String
  videoId     String
  reason      ReportReason
  description String?
  status      ReportStatus @default(PENDING)
  resolvedBy  String?
  resolvedAt  DateTime?
  createdAt   DateTime     @default(now())

  // Relations
  reporter User  @relation("ReporterReports", fields: [reporterId], references: [id])
  video    Video @relation(fields: [videoId], references: [id])
  resolver User? @relation("ReportResolver", fields: [resolvedBy], references: [id])

  @@index([videoId])
  @@index([status])
  @@index([reporterId])
}

// =============================================================================
// PAY MESSAGE MODEL (Pay-to-Chat)
// =============================================================================

model PayMessage {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  amount     Int      // Amount in TZS to view message
  content    String
  isRead     Boolean  @default(false)
  // End-to-end delivery evidence. `deliveredAt` is stamped the instant the row
  // is committed — at that point the message IS delivered, because it lives
  // server-side and the receiver's next read returns it. `readAt` records when
  // the receiver actually opened it. Together they let the sender see "delivered"
  // vs "read", which is the only honest thing to show without a per-device ack.
  deliveredAt DateTime @default(now())
  readAt      DateTime?
  createdAt  DateTime @default(now())

  sender   User @relation("SenderMessages", fields: [senderId], references: [id])
  receiver User @relation("ReceiverMessages", fields: [receiverId], references: [id])

  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
}

// =============================================================================
// HOLDING PERIOD LOG (tracks automatic balance transfers)
// =============================================================================

// =============================================================================
// ADMIN STRIKE LOG
// =============================================================================

model StrikeLog {
  id         String      @id @default(cuid())
  creatorId  String
  action     StrikeAction
  reason     String
  videoId    String?
  issuedBy   String
  createdAt  DateTime    @default(now())
  /// When the creator acknowledged reading this warning.
  ///
  /// A warning that only exists in a bell is a warning that was never read:
  /// the bell can be ignored, and a creator who never opened it keeps uploading
  /// until the ban lands. NULL therefore means "not seen yet", and the creator's
  /// own dashboard blocks on an unacknowledged warning until they press the one
  /// button that sets this — so the record of the warning and the record of it
  /// being read are the same row.
  acknowledgedAt DateTime?

  @@index([creatorId])
  @@index([issuedBy])
}

// =============================================================================
// CREATOR SUBSCRIPTIONS (Monthly recurring)
// =============================================================================

model CreatorSubscription {
  id            String   @id @default(cuid())
  viewerId      String
  creatorId     String
  price         Int      @default(5000) // TZS per month
  startDate     DateTime @default(now())
  expiresAt     DateTime
  isActive      Boolean  @default(true)
  autoRenew     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // --- Renewal bookkeeping (see subscription-renewal.service.ts) -------------
  // Renewals are attempted in the 24h before expiresAt. Each failed charge
  // increments renewAttempts; a successful one resets it and clears the error.
  renewAttempts      Int       @default(0)
  lastRenewAttemptAt DateTime?
  lastRenewedAt      DateTime?
  lastRenewError     String?
  // Last phone a gateway charge was sent to, so a renewal can push USSD again
  // without asking the fan to re-enter their number.
  renewPhone         String?

  viewer  User @relation("SubscriptionViewer", fields: [viewerId], references: [id], onDelete: Cascade)
  creator User @relation("SubscriptionCreator", fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([viewerId, creatorId])
  @@index([viewerId])
  @@index([creatorId])
  @@index([expiresAt])
}

