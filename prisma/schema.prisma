// =============================================================================
// SCENE PHOTO GALLERIES (image sets attached to a video)
// =============================================================================

model GalleryImage {
  id        String   @id @default(cuid())
  videoId   String
  url       String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId])
