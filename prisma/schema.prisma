// =============================================================================
// FREEBUFF - Video Monetization & Streaming Platform
// Complete Prisma Schema for PostgreSQL
// =============================================================================

generator client {
  provider = "prisma-client-js"
  // The client is generated once and then shipped somewhere else. Without this
  // line the generator downloads the query engine for the machine that ran
  // `prisma generate` and nothing else, so a client generated on a developer's
  // Windows laptop is useless to the Linux build image — and the reverse. The
  // failure surfaces as "Unable to require(...) : Prisma engines do not seem to
  // be compatible with your system", or as a PrismaClientInitializationError
  // with no errorCode, at whatever point a page first touches the database.
  //
  // `native` keeps local development and tests on the platform's own engine;
  // `rhel-openssl-3.0.x` is the engine Vercel's Node 20 runtime needs. Both are
  // fetched, so the build does not depend on which machine ran the generate.
  //
  // See src/tests/build-generates-client.test.ts, which pins this list.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum UserRole {
  VIEWER
  CREATOR
  ADMIN
}

enum KycStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum TransactionType {
  PPV_PURCHASE
  SUBSCRIPTION
  WALLET_TOPUP
  TIP
  PLATFORM_FEE
  REFERRAL_BONUS
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
  // A USSD prompt that we can neither confirm nor deny: the gateway accepted
  // the charge and never settled it, so the customer MAY already have paid.
  // Deliberately NOT "FAILED" — telling someone to "try again" when their money
  // left their handset is how the same purchase gets charged twice. Someone has
  // to check with the network before this becomes SUCCESS or FAILED.
  UNDER_INVESTIGATION
}

// Genhub settles every checkout through HarakaPay (USSD push to the phone).
// Kept as an enum so transactions stay self-describing if a second processor is
// ever added, but HARAKAPAY is the only supported value.
enum PaymentGateway {
  HARAKAPAY
}

enum PayoutMethod {
  MPESA
  TIGO_PESA
  AIRTEL_MONEY
  BANK_TRANSFER
}

enum PayoutStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

enum ReportReason {
  DMCA
  INAPPROPRIATE
  SPAM
  VIOLENCE
  OTHER
}

enum StrikeAction {
  WARNING
  HIDDEN
  FROZEN_EARNINGS
  BANNED
}

// =============================================================================
// USER MODEL
// =============================================================================

model User {
  id           String   @id @default(cuid())
  phone        String?  @unique
  email        String?  @unique
  passwordHash String
  displayName  String?
  avatarUrl    String?
  role         UserRole @default(VIEWER)
  kycStatus    KycStatus @default(NONE)
  isBanned     Boolean  @default(false)
  banReason    String?
  strikes      Int      @default(0)
  walletBalance Int     @default(0) // In TZS, stored as integer (kopecks not needed for TZS)
  isVerified    Boolean @default(false) // Public verification badge
  referralCode  String?  @unique // Shareable code for the affiliate program
  referredById  String?  // Who invited this user
  referralEarnings Int   @default(0) // Lifetime TZS earned from referrals
  locale       String   @default("sw") // sw = Kiswahili, en = English
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  videos              Video[]
  transactions        Transaction[]      @relation("ViewerTransactions")
  creatorTransactions Transaction[]      @relation("CreatorTransactions")
  videoAccess         VideoAccess[]
  reporterReports     VideoReport[]      @relation("ReporterReports")
  resolvedReports     VideoReport[]      @relation("ReportResolver")
  kycVerifications    KycVerification[]
  kycReviews          KycVerification[]  @relation("KYCReviewer")
  creatorBalance      CreatorBalance?
  payoutRequests      PayoutRequest[]
  processedPayouts    PayoutRequest[]    @relation("PayoutProcessor")
  sentMessages        PayMessage[]       @relation("SenderMessages")
  receivedMessages    PayMessage[]       @relation("ReceiverMessages")
  subscriptions       CreatorSubscription[] @relation("SubscriptionViewer")
  subscriberOf        CreatorSubscription[] @relation("SubscriptionCreator")
  videoLikes          VideoLike[]
  favorites           Favorite[]
  passwordResets      PasswordReset[]
  notifications       Notification[]
  comments            Comment[]
  watchProgresses     WatchProgress[]
  creatorProfile      CreatorProfile?
  referredBy          User?    @relation("Referrals", fields: [referredById], references: [id])
  referrals           User[]   @relation("Referrals")
  posts               CreatorPost[]
  playlists           Playlist[]
  couponRedemptions   CouponRedemption[]

  @@index([email])
  @@index([referralCode])
  @@index([phone])
  @@index([role])
  @@index([kycStatus])
  @@index([isBanned])
}

// =============================================================================
// KYC VERIFICATION MODEL
// =============================================================================

model KycVerification {
  id              String     @id @default(cuid())
  userId          String
  idDocumentUrl   String     // URL to uploaded government ID
  selfieUrl       String     // URL to selfie with handwritten note
  idDocumentType  String?    // NIDA, Passport, etc.
  status          KycStatus  @default(PENDING)
  rejectionReason String?
  reviewedBy      String?    // Admin userId who reviewed
  reviewedAt      DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  // Relations
  user     User @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewer User? @relation("KYCReviewer", fields: [reviewedBy], references: [id])

  @@index([userId])
  @@index([status])
}

// =============================================================================
// VIDEO MODEL
// =============================================================================

model Video {
  id              String   @id @default(cuid())
  creatorId       String
  title           String
  description     String?
  slug            String?  @unique
  bunnyVideoId    String   @unique // Bunny.net Stream Video ID
  previewUrl      String?  // Optional custom HLS URL (demo/migrated content overrides Bunny)
  /// Bunny id of a SEPARATE short clip shown to non-buyers. Without it a paid
  /// scene has no preview at all (see resolveTeaserUrl) — signing the main
  /// video for non-buyers hands them the whole scene, because Bunny tokens
  /// authorise a path and cannot limit duration.
  teaserBunnyVideoId String? @unique
  /// Same idea for side-loaded content: a stored, publicly reachable trailer
  /// URL (demo / migrated rows), symmetric with previewUrl. Ignored when
  /// teaserBunnyVideoId is set.
  teaserClipUrl   String?
  thumbnailUrl    String?
  /// WebVTT captions for this scene, as a URL the browser can fetch.
  ///
  /// Stored, because it cannot be derived: a subtitle file is not inside the
  /// video, and Bunny's transcoder does not produce one. Without somewhere to
  /// put it there was no way to attach captions at all — which for a deaf
  /// viewer is not a missing feature but a missing door, and for everyone else
  /// is the difference between watching on a noisy bus and not watching.
  captionsUrl     String?
  price           Int      @default(1000) // Price in TZS
  teaserDuration  Int      @default(15) // Seconds of free preview (UI: badge + hover length)
  duration        Int?     // Total duration in seconds
  viewsCount      Int      @default(0)
  likesCount      Int      @default(0)
  dislikesCount   Int      @default(0)
  purchaseCount   Int      @default(0)
  isPublished     Boolean  @default(false)
  isFlagged       Boolean  @default(false)
  isDeleted       Boolean  @default(false)
  isPremium       Boolean  @default(false) // Shown with lock + watermark
  isFeatured      Boolean  @default(false) // Highlighted in feed
  category        String?
  tags            String[]
  // 18 U.S.C. § 2257: set when the uploader attested that every performer is
  // an adult and that proof-of-age records are held on file.
  complianceAttestedAt DateTime?
  // ---------------------------------------------------------------------------
  // Bunny processing lifecycle.
  //
  // Null means "not tracked" — side-loaded/demo rows that Bunny does not
  // transcode, which must keep working exactly as they did before. Every other
  // value comes from Bunny itself; see lib/services/video-encoding.service.ts
  // for the code mapping and why "ready" never relies on one number alone.
  //
  // The states matter because Bunny accepts an upload long before the video can
  // actually play. Publishing on upload therefore puts a dead player in front of
  // paying viewers, which is what encodingStatus exists to prevent.
  encodingStatus      Int?
  /// Bunny's encodeProgress 0-100. Second, independent "is it done" signal.
  encodeProgress      Int      @default(0)
  /// Set only when Bunny reports a real failure, so creators see the reason.
  encodingError       String?
  encodingCheckedAt   DateTime?
  /// When the "it is ready" notification was sent. Guards against re-notifying
  /// on every poll, which would spam a creator every few minutes forever.
  encodingNotifiedAt  DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  creator         User          @relation(fields: [creatorId], references: [id])
  transactions    Transaction[]
  videoAccess     VideoAccess[]
  reports         VideoReport[]
  earnings        VideoEarning?
  likes           VideoLike[]
  favorites       Favorite[]
  comments        Comment[]
  watchProgresses WatchProgress[]
  playlistItems   PlaylistItem[]
  galleryImages   GalleryImage[]

  @@index([creatorId])
  @@index([isPublished])
  @@index([createdAt])
  @@index([price])
  // Drives the poller: find everything still encoding without scanning the table.
  @@index([encodingStatus])
}

// =============================================================================
// VIDEO EARNING (aggregated per video)
// =============================================================================

model VideoEarning {
  id              String   @id @default(cuid())
  videoId         String   @unique
  totalEarned     Int      @default(0) // 70% of purchases go here
  totalPurchases  Int      @default(0)
  updatedAt       DateTime @updatedAt

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId])
}

// =============================================================================
// TRANSACTION MODEL
// =============================================================================

model Transaction {
  id          String            @id @default(cuid())
  userId      String            // Viewer who paid
  creatorId   String?           // Creator who receives (null for wallet topup)
  videoId     String?           // For PPV_PURCHASE
  amount      Int               // Amount in TZS
  platformFee Int?              // 30% platform cut
  creatorCut  Int?              // 70% creator cut
  type        TransactionType
  status      TransactionStatus @default(PENDING)
  gateway     PaymentGateway?
  providerRef String?           // Reference from payment provider
  metadata    Json?             // Additional provider data
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  // Relations
  viewer     User              @relation("ViewerTransactions", fields: [userId], references: [id])
  creator    User?             @relation("CreatorTransactions", fields: [creatorId], references: [id])
  video      Video?            @relation(fields: [videoId], references: [id])

  @@index([userId])
  @@index([creatorId])
  @@index([videoId])
  @@index([status])
  @@index([type])
  @@index([providerRef])
  @@index([createdAt])
}

// =============================================================================
// CREATOR BALANCE MODEL
// =============================================================================

model CreatorBalance {
  id              String   @id @default(cuid())
  creatorId       String   @unique
  pendingBalance  Int      @default(0) // Funds within 14-day holding
  availableBalance Int     @default(0) // Funds available for payout
  totalEarned     Int      @default(0) // Lifetime earnings
  releasedTotal   Int      @default(0) // Cumulative amount released from holding (14-day maturity job)
  updatedAt       DateTime @updatedAt

  // Relations
  creator User @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([creatorId])
}

// =============================================================================
// PAYOUT REQUEST MODEL
// =============================================================================

model PayoutRequest {
  id             String       @id @default(cuid())
  creatorId      String
  amount         Int          // Amount in TZS
  paymentMethod  PayoutMethod
  accountDetails String       // Phone number or bank account
  bankName       String?      // For bank transfers
  status         PayoutStatus @default(PENDING)
  adminNote      String?
  processedBy    String?
  processedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Relations
  creator   User  @relation(fields: [creatorId], references: [id])
  processor User? @relation("PayoutProcessor", fields: [processedBy], references: [id])

  @@index([creatorId])
  @@index([status])
  @@index([createdAt])
}

// =============================================================================
// VIDEO ACCESS MODEL (tracks PPV purchases)
// =============================================================================

model VideoAccess {
  id        String   @id @default(cuid())
  viewerId  String
  videoId   String
  expiresAt DateTime? // Null = lifetime access
  createdAt DateTime @default(now())

  // Relations
  viewer User  @relation(fields: [viewerId], references: [id], onDelete: Cascade)
  video  Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([viewerId, videoId])
  @@index([viewerId])
  @@index([videoId])
}

// =============================================================================
// VIDEO REPORT MODEL
// =============================================================================

model VideoReport {
  id          String       @id @default(cuid())
  reporterId  String
  videoId     String
  reason      ReportReason
  description String?
  status      ReportStatus @default(PENDING)
  resolvedBy  String?
  resolvedAt  DateTime?
  createdAt   DateTime     @default(now())

  // Relations
  reporter User  @relation("ReporterReports", fields: [reporterId], references: [id])
  video    Video @relation(fields: [videoId], references: [id])
  resolver User? @relation("ReportResolver", fields: [resolvedBy], references: [id])

  @@index([videoId])
  @@index([status])
  @@index([reporterId])
}

// =============================================================================
// PAY MESSAGE MODEL (Pay-to-Chat)
// =============================================================================

model PayMessage {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  amount     Int      // Amount in TZS to view message
  content    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender   User @relation("SenderMessages", fields: [senderId], references: [id])
  receiver User @relation("ReceiverMessages", fields: [receiverId], references: [id])

  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
}

// =============================================================================
// HOLDING PERIOD LOG (tracks automatic balance transfers)
// =============================================================================

// =============================================================================
// ADMIN STRIKE LOG
// =============================================================================

model StrikeLog {
  id         String      @id @default(cuid())
  creatorId  String
  action     StrikeAction
  reason     String
  videoId    String?
  issuedBy   String
  createdAt  DateTime    @default(now())

  @@index([creatorId])
  @@index([issuedBy])
}

// =============================================================================
// CREATOR SUBSCRIPTIONS (Monthly recurring)
// =============================================================================

model CreatorSubscription {
  id            String   @id @default(cuid())
  viewerId      String
  creatorId     String
  price         Int      @default(5000) // TZS per month
  startDate     DateTime @default(now())
  expiresAt     DateTime
  isActive      Boolean  @default(true)
  autoRenew     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // --- Renewal bookkeeping (see subscription-renewal.service.ts) -------------
  // Renewals are attempted in the 24h before expiresAt. Each failed charge
  // increments renewAttempts; a successful one resets it and clears the error.
  renewAttempts      Int       @default(0)
  lastRenewAttemptAt DateTime?
  lastRenewedAt      DateTime?
  lastRenewError     String?
  // Last phone a gateway charge was sent to, so a renewal can push USSD again
  // without asking the fan to re-enter their number.
  renewPhone         String?

  viewer  User @relation("SubscriptionViewer", fields: [viewerId], references: [id], onDelete: Cascade)
  creator User @relation("SubscriptionCreator", fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([viewerId, creatorId])
  @@index([viewerId])
  @@index([creatorId])
  @@index([expiresAt])
}

// =============================================================================
// VIDEO LIKES
// =============================================================================

model VideoLike {
  id        String   @id @default(cuid())
  userId    String
  videoId   String
  type      String   @default("LIKE") // LIKE | DISLIKE
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
  @@index([userId])
  @@index([videoId])
}

// =============================================================================
// FAVORITES / WATCHLIST
// =============================================================================

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  videoId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
  @@index([userId])
  @@index([videoId])
}

// =============================================================================
// PASSWORD RESET TOKENS
// =============================================================================

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

// =============================================================================
// NOTIFICATIONS
// =============================================================================

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("info") // info, success, warning, error
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

// =============================================================================
// COMMENT MODEL (threaded — parentId for replies)
// =============================================================================

model Comment {
  id        String   @id @default(cuid())
  videoId   String
  userId    String
  parentId  String?
  body      String
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  video   Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentThread")

  @@index([videoId])
  @@index([userId])
  @@index([parentId])
}

// =============================================================================
// WATCH PROGRESS (resume + continue-watching)
// =============================================================================

model WatchProgress {
  id              String   @id @default(cuid())
  userId          String
  videoId         String
  positionSeconds Int      @default(0)
  percent         Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
  @@index([userId])
  @@index([updatedAt])
}

// =============================================================================
// CREATOR PROFILE / SETTINGS
// =============================================================================

// =============================================================================
// COUPON / PROMO CODES
// =============================================================================

model Coupon {
  id        String    @id @default(cuid())
  code      String    @unique // Stored uppercase, e.g. WELCOME10
  type      String    @default("PERCENT") // PERCENT | FIXED (TZS off)
  value     Int // 10 = 10% off, or 500 = TZS 500 off
  isActive  Boolean   @default(true)
  maxUses   Int? // null = unlimited
  usedCount Int       @default(0)
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  redemptions CouponRedemption[]

  @@index([code])
  @@index([isActive])
}

// =============================================================================
// COUPON REDEMPTION (who already spent it)
//
// `maxUses` is a global budget and says nothing about one account: without this
// table a single user could spend the whole of it, and a coupon created with no
// `maxUses` was unlimited per person as well as in total. The unique pair is the
// rule — one redemption per user per coupon — and it is what makes the write in
// consumeCoupon() safe to race against itself.
//
// The row is written in the same transaction that increments usedCount, and only
// from a settlement path, so a checkout nobody ever paid for does not consume a
// coupon.
// =============================================================================

model CouponRedemption {
  id            String   @id @default(cuid())
  couponId      String
  userId        String
  /// The settled charge this coupon was spent on, when there was one.
  transactionId String?
  createdAt     DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([couponId, userId])
  @@index([couponId])
  @@index([userId])
}

// =============================================================================
// CREATOR POSTS (status / timeline feed — OnlyFans style)
// =============================================================================

model CreatorPost {
  id        String   @id @default(cuid())
  creatorId String
  body      String
  imageUrl  String?
  createdAt DateTime @default(now())

  creator User @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([creatorId])
  @@index([createdAt])
}

// =============================================================================
// CREATOR PROFILE / SETTINGS
// =============================================================================

model CreatorProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  bio             String?
  coverImageUrl   String?
  subscriptionPrice Int?   @default(5000) // Monthly subscription price
  socialLinks     Json?    // { twitter, instagram, youtube, tiktok }
  totalSubscribers Int     @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// =============================================================================
// PLAYLISTS / WATCH LATER
// =============================================================================

model Playlist {
  id          String   @id @default(cuid())
  userId      String
  name        String
  /// Exactly one auto-created playlist per user ("Watch Later") — cannot be renamed or deleted
  isWatchLater Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items PlaylistItem[]

  @@index([userId])
}

model PlaylistItem {
  id         String   @id @default(cuid())
  playlistId String
  videoId    String
  position   Int      @default(0)
  createdAt  DateTime @default(now())

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  video    Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([playlistId, videoId])
  @@index([playlistId])
  @@index([videoId])
}

// =============================================================================
// SCENE PHOTO GALLERIES (image sets attached to a video)
// =============================================================================

model GalleryImage {
  id        String   @id @default(cuid())
  videoId   String
  url       String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId])
}

// =============================================================================
// ADMIN AUDIT LOG
//
// Every action an admin takes that changes somebody else's account, money or
// content, recorded once, in one table, with who did it and when.
//
// Until this existed, the only trace of a ban, a coupon, a KYC decision or a
// payout approval was the CONSEQUENCE: `User.isBanned` true, a payout row in
// PAID, a notification the customer received. None of them says who decided, or
// why, and several of them destroy the previous value as they write (`banReason`
// is overwritten by the next ban/unban, `adminNote` by the next decision). So
// "who banned this creator?" had no answer anywhere in the system — which is a
// question a platform taking money has to be able to answer, both for the
// creator who asks and for whoever is investigating an abuse of admin access.
//
// `summary` is stored, not derived, and it is a sentence rather than a code.
// The reason is the difference between a log an operator reads during an
// incident and a table that is only ever queried by machine: "Banned Ivanny
// (3 strikes) — reason: Terms violation" answers the question at a glance.
// Codes live in `action` for filtering; the sentence is for the human.
//
// No relation to User on purpose. `actorId` and `targetId` are ids, not foreign
// keys: deleting an account must not delete the record of what was done to it,
// and Prisma would cascade or refuse.
// =============================================================================

model AdminAuditLog {
  id         String   @id @default(cuid())
  /// The admin who acted. Not a relation — see the note above.
  actorId    String
  /// Dotted code for filtering, e.g. user.ban, coupon.create, payout.paid.
  action     String
  /// What kind of thing was acted on: User, Coupon, PayoutRequest, KycVerification…
  targetType String?
  targetId   String?
  /// One human sentence describing what happened.
  summary    String
  /// Anything else worth keeping: previous value, amount, reason.
  detail     Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([targetId])
  @@index([createdAt])
}

// =============================================================================
// BACKGROUND JOB HEARTBEATS
//
// One row per scheduled worker, written by the worker itself on every run.
//
// This exists because a schedule that stops firing is the one failure nothing
// else in the app can see: no request arrives, so no log line, no error, no
// metric. The absence of a row is therefore the signal — which only works
// because the worker writes it, so an unimplemented worker looks "never run"
// rather than healthy.
//
// `worker` matches a key in lib/services/cron-heartbeat.service.ts, where the
// expected cadence lives. Deleting a row is safe: it reads as "never ran".
// =============================================================================

model CronHeartbeat {
  id                  String    @id @default(cuid())
  worker              String    @unique
  /// Set when a run begins — lets a run that was killed mid-flight (function
  /// timeout, crash) be told apart from one that has not started yet.
  lastStartedAt       DateTime?
  /// Held for the duration of a run and cleared when it returns.
  ///
  /// Claimed with a single conditional UPDATE, which is what makes a double
  /// fire safe: two schedulers (Vercel Cron *and* GitHub Actions) or one
  /// double-clicked button cannot both start the same job. A run that dies
  /// without releasing it expires on its own after inFlightGraceMinutes.
  runLockedAt         DateTime?
  lastFinishedAt      DateTime?
  /// OK | ERROR. Null until the first run finishes.
  lastOutcome         String?
  /// Human-readable result, e.g. "Released TZS 12,000 for 2 creator(s)".
  lastSummary         String?
  /// Who started the last run — null for a scheduled one. The uptime watchdog
  /// restarts a worker whose schedule has died and declares itself, so "it is
  /// running again" can be told apart from "the schedule came back": the second
  /// is a fixed problem, and reading one as the other closes the ticket too
  /// early. It is a column rather than a suffix inside lastSummary because the
  /// recovery notice has to test it, and testing a human sentence is how the two
  /// drift apart.
  lastOrigin          String?
  lastError           String?
  lastDurationMs      Int?
  consecutiveFailures Int       @default(0)
  runsTotal           Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

/// The uptime watchdog's memory of what it already reported.
///
/// Without this, "is that worker fine now?" cannot be answered: a heartbeat only
/// describes the present, so a worker that recovered an hour ago looks exactly
/// like one that was never broken — and the operator keeps chasing a schedule
/// that has already been fixed. One row per worker that the watchdog has seen
/// needing attention; the row is closed out with `resolvedAt` rather than
/// deleted, so the app keeps the record even when a webhook delivery fails.
model CronWatch {
  id           String    @id @default(cuid())
  worker       String    @unique
  /// When the trouble began — the same instant the alarm dated it, so "nothing
  /// finished for 4 h" and "running again after 4 h" line up. Kept on later
  /// sightings: re-dating it would reset a week-long outage to "0 min" on every
  /// run, and how long it was stuck is the number worth knowing.
  alertedAt    DateTime
  /// The state reported on the latest sighting (late | stalled | failing), so a
  /// recovery can say what it was.
  alertedState String
  /// When the watchdog next found it healthy. Null while it is still down.
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([worker])
}
