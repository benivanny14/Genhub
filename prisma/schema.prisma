// =============================================================================
// ADMIN AUDIT LOG
//
// Every action an admin takes that changes somebody else's account, money or
// content, recorded once, in one table, with who did it and when.
//
// Until this existed, the only trace of a ban, a coupon, a KYC decision or a
// payout approval was the CONSEQUENCE: `User.isBanned` true, a payout row in
// PAID, a notification the customer received. None of them says who decided, or
// why, and several of them destroy the previous value as they write (`banReason`
// is overwritten by the next ban/unban, `adminNote` by the next decision). So
// "who banned this creator?" had no answer anywhere in the system — which is a
// question a platform taking money has to be able to answer, both for the
// creator who asks and for whoever is investigating an abuse of admin access.
//
// `summary` is stored, not derived, and it is a sentence rather than a code.
// The reason is the difference between a log an operator reads during an
// incident and a table that is only ever queried by machine: "Banned Ivanny
// (3 strikes) — reason: Terms violation" answers the question at a glance.
// Codes live in `action` for filtering; the sentence is for the human.
//
// No relation to User on purpose. `actorId` and `targetId` are ids, not foreign
// keys: deleting an account must not delete the record of what was done to it,
// and Prisma would cascade or refuse.
// =============================================================================

model AdminAuditLog {
  id         String   @id @default(cuid())
  /// The admin who acted. Not a relation — see the note above.
  actorId    String
  /// Dotted code for filtering, e.g. user.ban, coupon.create, payout.paid.
  action     String
  /// What kind of thing was acted on: User, Coupon, PayoutRequest, KycVerification…
  targetType String?
  targetId   String?
  /// One human sentence describing what happened.
  summary    String
  /// Anything else worth keeping: previous value, amount, reason.
  detail     Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([targetId])
  @@index([createdAt])
}

// =============================================================================
// BACKGROUND JOB HEARTBEATS
//
// One row per scheduled worker, written by the worker itself on every run.
//
// This exists because a schedule that stops firing is the one failure nothing
// else in the app can see: no request arrives, so no log line, no error, no
// metric. The absence of a row is therefore the signal — which only works
// because the worker writes it, so an unimplemented worker looks "never run"
// rather than healthy.
//
// `worker` matches a key in lib/services/cron-heartbeat.service.ts, where the
// expected cadence lives. Deleting a row is safe: it reads as "never ran".
// =============================================================================

model CronHeartbeat {
  id                  String    @id @default(cuid())
  worker              String    @unique
  /// Set when a run begins — lets a run that was killed mid-flight (function
  /// timeout, crash) be told apart from one that has not started yet.
  lastStartedAt       DateTime?
  /// Held for the duration of a run and cleared when it returns.
  ///
  /// Claimed with a single conditional UPDATE, which is what makes a double
  /// fire safe: two schedulers (Vercel Cron *and* GitHub Actions) or one
  /// double-clicked button cannot both start the same job. A run that dies
  /// without releasing it expires on its own after inFlightGraceMinutes.
  runLockedAt         DateTime?
  lastFinishedAt      DateTime?
  /// OK | ERROR. Null until the first run finishes.
  lastOutcome         String?
  /// Human-readable result, e.g. "Released TZS 12,000 for 2 creator(s)".
  lastSummary         String?
  /// Who started the last run — null for a scheduled one. The uptime watchdog
  /// restarts a worker whose schedule has died and declares itself, so "it is
  /// running again" can be told apart from "the schedule came back": the second
  /// is a fixed problem, and reading one as the other closes the ticket too
  /// early. It is a column rather than a suffix inside lastSummary because the
  /// recovery notice has to test it, and testing a human sentence is how the two
  /// drift apart.
  lastOrigin          String?
  lastError           String?
  lastDurationMs      Int?
  consecutiveFailures Int       @default(0)
  runsTotal           Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

// =============================================================================
// LAUNCH SETUP: steps an operator has ticked off by hand
//
// Some launch steps live in somebody else's dashboard — fund the gateway float,
// allow the domain as a Bunny referrer — and no code can detect whether they
// are done. Counting them as "todo" forever is what left the Setup badge stuck
// at a number nobody could clear, so the operator records it here instead: the
// badge counts what is genuinely outstanding, and this is the proof of the rest.
// =============================================================================

model SetupStep {
  /// The checklist item id (e.g. "sonicpesa_client_id"), so a step cannot be
  /// ticked twice and the record survives the checklist being reordered.
  id     String   @id
  title  String
  doneAt DateTime @default(now())
  /// Which admin ticked it. Nullable so a row survives that admin's deletion.
  doneBy String?
}

// =============================================================================
// BLUE TICK (PAID VERIFICATION)
//
// The tick is bought, not earned: a creator pays TZS 10,000 for a month of it,
// an admin approves, and it comes down on its own when the month ends. One row
// per purchase, kept forever — a refund, a rejection and a renewal are all
// events on this table, and a receipt that gets deleted to save space cannot
// answer "what did this creator pay us for".
// =============================================================================

model BlueTickRequest {
  id              String         @id @default(cuid())
  userId          String
  /// TZS charged for this request. Stored rather than recomputed from the
  /// current price: a refund has to give back what was actually taken.
  amount          Int
  /// Months bought, so one request can cover a longer period (1-12).
  months          Int            @default(1)
  status          BlueTickStatus @default(PAID)
  /// WALLET | EARNINGS — where the money came from, so a refund goes back to
  /// the same place instead of guessing.
  paymentMethod   String
  /// The ledger row for the charge.
  transactionId   String?
  paidAt          DateTime       @default(now())
  /// Live window, set when an admin approves.
  startsAt        DateTime?
  expiresAt       DateTime?
  reviewedBy      String?
  reviewedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
}

/// The uptime watchdog's memory of what it already reported.
///
/// Without this, "is that worker fine now?" cannot be answered: a heartbeat only
/// describes the present, so a worker that recovered an hour ago looks exactly
/// like one that was never broken — and the operator keeps chasing a schedule
/// that has already been fixed. One row per worker that the watchdog has seen
/// needing attention; the row is closed out with `resolvedAt` rather than
/// deleted, so the app keeps the record even when a webhook delivery fails.
// =============================================================================
// PLATFORM SETTINGS (operator switches that affect every account)
//
// A small key/value table, deliberately. The first entry is the admin's
// "all videos are free right now" switch: while it is on, every paid scene plays
// for everyone — signed in or not — without a purchase, a subscription or a
// charge, and the switch is recorded in AdminAuditLog (videos.all_free /
// videos.paid) so "who opened the whole catalogue, and when?" has an answer.
//
// A row rather than an environment variable because the whole point is that an
// admin flips it from the panel and it takes effect immediately, with no
// redeploy — and a table rather than a boolean column on a singleton because the
// next operator switch should not need its own migration.
// =============================================================================

model PlatformSetting {
  key       String   @id
  value     String
  /// The admin who last changed it. Not a relation — a setting outlives the
  /// account that set it, and deleting that admin must not erase the switch.
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@index([key])
}

/// The clip an operator has put behind every page, bytes included.
///
/// It lives in the database rather than on disk because there IS no persistent
/// disk: the deployment runs on Vercel, where `public/` is read-only, `/tmp`
/// belongs to one instance and is gone by the next request, and any payload a
/// function sends or receives is capped at 4.5 MB. The clip is therefore small
/// by construction (see MAX_BACKGROUND_VIDEO_BYTES), and this row is the whole
/// of it — no path, no bucket, no second store to keep in step.
///
/// `id` is the SAME 24-hex token the settings row carries and the browser puts
/// in `?v=`. It was the filename before; it is the primary key now, which is
/// why the token check in lib/background-video.ts is still the only thing
/// standing between a stored row and the bytes it is allowed to reach.
model BackgroundVideoAsset {
  id        String   @id
  mimeType  String
  /// The name the operator chose, kept for their own card. Never used as a path.
  name      String
  /// Bytes in `data`, duplicated here so a HEAD or a range request can answer
  /// without pulling the clip out of storage.
  size      Int
  /// The clip itself.
  data      Bytes
  createdAt DateTime @default(now())
}

model CronWatch {
  id           String    @id @default(cuid())
  worker       String    @unique
  /// When the trouble began — the same instant the alarm dated it, so "nothing
  /// finished for 4 h" and "running again after 4 h" line up. Kept on later
  /// sightings: re-dating it would reset a week-long outage to "0 min" on every
  /// run, and how long it was stuck is the number worth knowing.
  alertedAt    DateTime
  /// The state reported on the latest sighting (late | stalled | failing), so a
  /// recovery can say what it was.
  alertedState String
  /// When the watchdog next found it healthy. Null while it is still down.
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([worker])
}
