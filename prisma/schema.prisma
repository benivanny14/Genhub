// =============================================================================
// CREATOR PROFILE / SETTINGS
// =============================================================================

// =============================================================================
// COUPON / PROMO CODES
// =============================================================================

model Coupon {
  id        String    @id @default(cuid())
  code      String    @unique // Stored uppercase, e.g. WELCOME10
  type      String    @default("PERCENT") // PERCENT | FIXED (TZS off)
  value     Int // 10 = 10% off, or 500 = TZS 500 off
  isActive  Boolean   @default(true)
  maxUses   Int? // null = unlimited
  usedCount Int       @default(0)
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  redemptions CouponRedemption[]

  @@index([code])
  @@index([isActive])
}

// =============================================================================
// COUPON REDEMPTION (who already spent it)
//
// `maxUses` is a global budget and says nothing about one account: without this
// table a single user could spend the whole of it, and a coupon created with no
// `maxUses` was unlimited per person as well as in total. The unique pair is the
// rule — one redemption per user per coupon — and it is what makes the write in
// consumeCoupon() safe to race against itself.
//
// The row is written in the same transaction that increments usedCount, and only
// from a settlement path, so a checkout nobody ever paid for does not consume a
// coupon.
// =============================================================================

model CouponRedemption {
  id            String   @id @default(cuid())
  couponId      String
  userId        String
  /// The settled charge this coupon was spent on, when there was one.
  transactionId String?
  createdAt     DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([couponId, userId])
  @@index([couponId])
  @@index([userId])
}

// =============================================================================
// CREATOR POSTS (status / timeline feed — OnlyFans style)
// =============================================================================

model CreatorPost {
  id        String   @id @default(cuid())
  creatorId String
  body      String
  imageUrl  String?
  createdAt DateTime @default(now())

  creator User @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([creatorId])
  @@index([createdAt])
}

// =============================================================================
// CREATOR PROFILE / SETTINGS
// =============================================================================

model CreatorProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  bio             String?
  coverImageUrl   String?
  // Monthly subscription price. The default matches SUBSCRIPTION_PRICE_TZS in
  // lib/subscription.ts — a profile made without a price must cost the same as
  // one made with it, or a new subscriber sees a number no screen ever offered.
  subscriptionPrice Int?   @default(8000)
  socialLinks     Json?    // { twitter, instagram, youtube, tiktok }
  totalSubscribers Int     @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

