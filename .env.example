[TEMPLATE]
# =============================================================================
# GENHUB - Environment template
# Copy to .env.local and fill in real values:  cp .env.example .env.local
# Never commit .env.local.
#
#   Where to get each value, step by step:  SETUP.md
#   Prove they actually work:               npm run verify:live
#   Deploy checklist:                       PRODUCTION.md
#
# Comments after a value are stripped, so this file can be copied as-is.
# =============================================================================

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000     # production: https://your-domain.com (no trailing slash)
NEXT_PUBLIC_APP_NAME=Genhub

# --- Legal / compliance (28 C.F.R. 75.2 records statement) ------------------
NEXT_PUBLIC_COMPANY_LEGAL_NAME=               # registered entity shown on /2257
NEXT_PUBLIC_COMPANY_ADDRESS=                  # custodian real place of business (required on /2257)
NEXT_PUBLIC_SUPPORT_EMAIL=                    # your-name@your-domain.com - an inbox you actually
                                              # read: DMCA notices and account recovery land here
NEXT_PUBLIC_SUPPORT_PHONE=                    # the public support line, e.g. 0682642219. Shown on the
                                              # footer and /support as a tel: link. Leave it empty and
                                              # the site falls back to a real, dialable number - never
                                              # to a placeholder a visitor can call by mistake.
# NODE_ENV is set by Next.js (production automatically)

# --- Database / cache ------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/genhub
# Redis, one of two ways. The Upstash REST pair WINS whenever both are set, and
# it is the one that works on serverless: HTTPS, no TCP pool held open between
# invocations. REDIS_URL alone is fine for a self-hosted server, but a
# redis://localhost value on a host is dead config — rate limiting then degrades
# to per-instance counters and every deploy starts with a cold cache.
UPSTASH_REDIS_REST_URL=                        # e.g. https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=
REDIS_URL=redis://localhost:6379              # only used when the REST pair is absent
# Where `npm test` is allowed to write. It creates creators, moves money and
# deletes rows, so it must never name the live database once DATABASE_URL is
# one — with no TEST_DATABASE_URL the database-backed suites skip instead of
# touching it. A Neon branch is free and disposable: point this at one.
# TEST_DATABASE_URL=postgresql://user:password@ep-xxx.aws.neon.tech/genhub_test?sslmode=require
# Escape hatch, only for a database you accept being rewritten by a test run:
# ALLOW_TESTS_ON_EXTERNAL_DB=1

# --- Auth ------------------------------------------------------------------
JWT_SECRET=                                   # openssl rand -hex 32 (rotate for production! never reuse the dev value)
JWT_EXPIRES_IN=7d
COOKIE_NAME=genhub_token

# --- Payments: SonicPesa (the only gateway) --------------------------------
PAYMENT_SANDBOX=true                           # true = NO gateway call at all (no USSD push); FALSE for live money
# SonicPesa dashboard -> API Settings: copy the Access Key and Secret Key. The
# Access Key is sent as the X-API-KEY header; the Secret Key signs webhooks.
# Neither value ever reaches the browser.
SONICPESA_ACCESS_KEY=sk_live_...
SONICPESA_SECRET_KEY=
SONICPESA_BASE_URL=https://api.sonicpesa.com/api/v1
# Webhook verification. Preferred: SONICPESA_SECRET_KEY, which signs every
# callback (HMAC-SHA256 over the raw body, header X-SonicPesa-Signature) so the
# secret never travels in a URL. Alternative: SONICPESA_WEBHOOK_TOKEN, appended
# as ?t= to the webhook URL you register in the SonicPesa dashboard (API
# Settings -> Webhook URL -> https://<domain>/api/webhooks/sonicpesa). With
# NEITHER set, production refuses every callback. SonicPesa has no prepaid
# float: collections settle straight into your account, so there is nothing to
# top up here.
SONICPESA_WEBHOOK_TOKEN=                      # openssl rand -hex 24

# --- Payouts: sending creators their money ---------------------------------
# Taking money in and sending it out are separate permissions on the SonicPesa
# account, so automatic payouts are OFF unless this is true. With it off, an
# admin still approves a withdrawal and still sends it by hand — the app just
# never calls the payout endpoint.
SONICPESA_PAYOUTS_ENABLED=false
# The payout endpoints require a SECOND header (X-API-SECRET) alongside the
# Access Key; the Key alone is refused. SonicPesa calls that value "the API
# secret" in both places it uses it, so when this is EMPTY the value of
# SONICPESA_SECRET_KEY is used. Fill this in only if the dashboard shows a
# different secret for payouts.
SONICPESA_API_SECRET=
# The smallest payout the gateway will SEND, in TZS. Default 30000.
#
# This is NOT Genhub's withdrawal rule (config.business.minPayoutAmount, a
# policy an admin can waive for one creator). It is the
# gateway's own limit: asked to send less, it answers "The amount field must
# be at least 30000" and transfers nothing. A withdrawal under it cannot be
# sent automatically and is paid by hand instead, so this only has to change
# if SonicPesa changes theirs. When the gateway names a different floor in a
# reply, the app believes the reply for the rest of the process.
SONICPESA_MIN_PAYOUT=30000

# The most one account may SPEND from its wallet in a rolling 24 hours, across
# every paid action (video purchases, subscriptions, tips and paid messages).
# The per-transaction limits bound a single charge; this bounds a day of them,
# which is what a stolen session or a script abuses. Incoming money — wallet
# top-ups and referral bonuses — never counts toward it. Set 0 to disable.
DAILY_SPEND_CAP=500000

# --- Background jobs -------------------------------------------------------
CRON_SECRET=                                  # openssl rand -hex 24; sent by vercel.json / GitHub Actions

# --- Uptime watchdog (scripts/watchdog.mjs, .github/workflows/uptime.yml) --
# Lives in GitHub → Settings → Secrets and variables → Actions, NOT on the host.
APP_URL=                                        # repository Variable: https://your-domain (the site the watchdog checks)
ALERT_WEBHOOK_URL=                              # repository Secret (optional): Slack or Discord webhook for alarms
# Add CRON_SECRET (above) as a repository Secret as well and the alarm names the
# worker that stopped, not only the verdict — and the watchdog restarts a stopped
# worker itself, except renew-subscriptions, which can charge a customer's phone
# and is therefore never started automatically. Optional: without it the alarm
# fires exactly as loudly, with a line less context. See PRODUCTION.md §4.0.2.
# Repository VARIABLE, not a secret: set it to "off" to stop the automatic
# restarts while keeping the alarm. Anything unrecognised also counts as off.
WATCHDOG_RECOVER=                               # unset = restarts on; "off" = alarm only

# --- Email (SMTP) — required for password reset in production --------------
SMTP_HOST=                                     # e.g. smtp.resend.com, smtp.gmail.com, smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Genhub <no-reply@your-domain>

# --- SMS (Africa's Talking) — password reset for phone-only accounts -------
AT_API_KEY=                                    # Africa's Talking API key
AT_USERNAME=                                   # your AT username (or "sandbox" for testing)
AT_SENDER_ID=                                  # optional sender ID

# --- Bunny.net video (Stream) ----------------------------------------------
# The Stream library holds VIDEO files. The server creates a short-lived signed
# TUS session; the browser sends resumable chunks directly to Bunny. The API key
# never reaches the browser.
BUNNY_STREAM_API_KEY=                         # Stream API key; keep it server-side only.
BUNNY_STREAM_LIBRARY_ID=                      # Stream library id
# Signs the callbacks Bunny Stream posts to /api/webhooks/bunny when a video
# changes state (most importantly when encoding finishes). Bunny computes
# HMAC-SHA256 over the raw request body with the library's READ-ONLY API key, so
# paste that key here (Bunny -> Stream -> your library -> API keys -> Read-Only
# key) and set https://<your-domain>/api/webhooks/bunny as the library's webhook
# URL. It is a SEPARATE value from BUNNY_STREAM_API_KEY and can be rotated
# without breaking uploads. Leave empty in dev to accept unsigned callbacks; in
# production an empty value makes the route refuse every callback (fail closed).
BUNNY_STREAM_WEBHOOK_SECRET=
# A HOSTNAME, not a key. No scheme, no trailing slash, no port:
#   BUNNY_CDN_HOSTNAME=vz-abcd1234-efgh.b-cdn.net
# COPY IT, do not invent it: Bunny reports the value as `thumbnailUrl` in
#   GET video.bunnycdn.com/library/<libraryId>/videos/<guid>/play
BUNNY_CDN_HOSTNAME=
# The KEY that authorises those videos belongs here, one variable down — a value
# pasted into BUNNY_CDN_HOSTNAME only produces CDN addresses that do not resolve.
BUNNY_TOKEN_SECRET=                           # COPY IT, do not generate it. This is the pull zone's own
                                              #   "URL Token Authentication Key":
                                              #   CDN -> your pull zone -> Security -> Token Authentication.
                                              #   The app signs a manifest path as
                                              #   base64url(sha256(key + path + expires)) and sends it as
                                              #   ?token=...&expires=...; a random string here makes Bunny
                                              #   answer 403 and the player spins forever. The value is
                                              #   hashed byte for byte, so a stray space or newline pasted
                                              #   along with it fails exactly like a wrong key: paste with no
                                              #   surrounding quotes and no whitespace.
                                              #   /api/health/services signs a real manifest against the live
                                              #   zone and appends this key's fingerprint as 8 hex
                                              #   characters, so two environments can be compared without
                                              #   ever printing the secret.

# --- Bunny.net images (Storage) --------------------------------------------
# A DIFFERENT Bunny product from Stream. Thumbnails, avatars, gallery photos and
# KYC documents are objects in this storage zone, served to the browser by
# /api/media/<key> — the app reads them with the access key below, because a
# storage zone has no CDN hostname of its own.
#
# The key's first segment decides who may read it:
#   public/...          anyone (thumbnails, avatars)
#   private/<userId>/   that user, or an admin (KYC documents)
BUNNY_STORAGE_ZONE=                           # storage zone name
BUNNY_STORAGE_ACCESS_KEY=                     # storage API key

# --- Browser push notifications (Web Push / VAPID) --------------------------
# Optional. ABSENT IS SAFE: with no keys here the app behaves exactly as it did
# before push existed — the notifications toggle is hidden and every send is a
# no-op — so a deployment that has not set these is not broken.
#
# Generate a key pair once, and keep the same pair: rotating it silently
# invalidates every existing subscription, so the private key is a secret to
# back up, not a value to regenerate carelessly.
#
#   npx web-push generate-vapid-keys
#
VAPID_PUBLIC_KEY=                             # public half; served to the browser
VAPID_PRIVATE_KEY=                            # private half; NEVER sent to a client
VAPID_SUBJECT=mailto:support@example.com      # a contact the push services can reach
